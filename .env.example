# =============================================================================
# Fresh Distribution Business OS Bekasi — Environment Configuration Template
# Copy to `.env.local` for local development. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Connections
# -----------------------------------------------------------------------------
# Local development example:
#   DATABASE_URL=postgres://localhost:5432/buah_dev
# Supabase PostgreSQL (Session Pooler IPv4 port 5432 or Direct connection with SSL):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# IMPORTANT: Do NOT use Supabase Transaction Pooler (port 6543 / pgbouncer=true) for
# `npm run db:migrate` or deferred constraint triggers (`SET CONSTRAINTS` / advisory locks).
DATABASE_URL=postgres://localhost:5432/buah_dev

# Isolated test database. MUST end with `_test` — test runner refuses any other DB name.
TEST_DATABASE_URL=postgres://localhost:5432/buah_test

# -----------------------------------------------------------------------------
# 2. Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Generate a strong secret (>= 32 random chars): `openssl rand -base64 32`
# REQUIRED in production (`NODE_ENV=production`); startup fails if missing or < 32 chars.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-minimum-32-characters

# Canonical base URL of the deployment (no trailing slash).
# On Vercel Preview, if left empty, falls back to `https://${VERCEL_URL}`.
# On Production, set explicitly to the canonical domain.
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 3. Application URLs & Environment Mode
# -----------------------------------------------------------------------------
# Base URL used when generating Customer QR Order links (`/order/<code>`).
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment label: development | test | uat | production
# Setting `APP_ENV=production` disables all synthetic dev login helpers.
APP_ENV=development

# -----------------------------------------------------------------------------
# 4. Private Payment Proof Storage
# -----------------------------------------------------------------------------
# Directory for storing customer QR payment proofs outside `public/`.
# Local default: `./storage/private/proofs`
# Serverless / Vercel note: use `/tmp/private-proofs` only for ephemeral preview testing;
# for persistent production on Vercel, back with durable private object storage.
PRIVATE_STORAGE_DIR=

# -----------------------------------------------------------------------------
# 5. Initial Owner Bootstrap (`npm run setup:owner` — one-time on clean DB)
# -----------------------------------------------------------------------------
# Used ONLY when running `npm run setup:owner` to create the first Owner account.
# Clear or rotate after initial bootstrap. Password must be at least 8 characters.
OWNER_USERNAME=
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# -----------------------------------------------------------------------------
# 6. Local Development & Automated Testing Only (NEVER set in Production)
# -----------------------------------------------------------------------------
# Used only by `npm run seed:dev` (blocked when NODE_ENV=production or APP_ENV=production)
# and the local dev login quick-fill panel. Leave empty in UAT/Preview/Production.
DEV_SEED_PASSWORD=

# Base URL for Playwright E2E test suite (`npm run e2e`)
PLAYWRIGHT_BASE_URL=http://localhost:3000
